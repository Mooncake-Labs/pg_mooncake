-------------------------
 Mixed Schema.Mirror "Q"
(1 row)

CREATE TABLE src$1 (id int PRIMARY KEY);
CALL mooncake.create_table('Mc$1', 'SRC$1');
INSERT INTO src$1 VALUES (1);
